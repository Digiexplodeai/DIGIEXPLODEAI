# ============================================================
# DigiExplodeAI — Environment Variables Configuration Template
# ============================================================

# ── Primary Database & Cloudflare Worker API ─────────────────
VITE_WORKER_URL=https://digiexplodai.digiexplodeai.workers.dev

# ── Firebase Authentication Client ───────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0746984388
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_google_analytics_measurement_id_here

# ── Multi-Channel Password Recovery: Transactional Email ─────
# Resend API (Recommended for Cloudflare Workers & SaaS):
# Register at https://resend.com and obtain an API key.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=DigiExplodeAI Security <security@digiexplode.ai>

# ── Multi-Channel Password Recovery: Mobile SMS & OTP ────────
# Option A: Twilio (Global SMS delivery)
# Register at https://twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890

# Option B: Fast2SMS (India domestic SMS delivery)
# Register at https://fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Gemini Natural Language Assistant (Optional) ────────────
GEMINI_API_KEY=your_gemini_api_key_here
